# secure password, can use `openssl rand -hex 32`
NUXT_SESSION_PASSWORD=""

# HMAC secret for image-proxy, can use `openssl rand -hex 32`
NUXT_IMAGE_PROXY_SECRET=""

# root of Nuxt-derived secrets such as OG image URL signing (at least 32 characters), can use `openssl rand -hex 32`
NUXT_APP_SECRET=""
